*.sqlite3
cache/

# Outputs (generated, not source)
quality/
analysis/
reports/
*.log

# results/ is generated too, with one exception: the published run
# artifact the README points at. git will not descend into an ignored
# directory, so ignore the contents rather than the directory itself.
results/*
!results/2026-05-run/
!results/2026-05-run/**

# OS
.DS_Store
Thumbs.db
