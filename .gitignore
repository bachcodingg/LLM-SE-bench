# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# IDE
.vscode/
.idea/
*.swp
*.swo

# Local databases — the response cache holds full prompts and model
# outputs. Ship the schema and a migration, never the data.
*.db
*.sqlite
*.sqlite3
cache/

# Outputs (generated, not source)
analysis/
reports/
*.log

# quality/ is NOT purely generated: it holds the C3 source (ck_metrics,
# complexity, readability, refactoring, structural, tamper, difftest) as
# well as one output directory per dataset. Ignoring the whole package —
# which this file used to do — silently left C3 out of the repository
# while cli.py and every MCP tool imported it, so a fresh clone could not
# run. Ignore the per-dataset output directories only.
quality/*/
!quality/tests/
!quality/test_data/

# results/ is generated too, with exceptions: the published run artifacts
# the README points at, and the withdrawn May run kept as the audit's
# record. git will not descend into an ignored directory, so ignore the
# contents rather than the directory itself.
results/*
!results/2026-05-run/
!results/2026-05-run/**
!results/2026-10-run/
!results/2026-10-run/**
!results/2026-10-agent/
!results/2026-10-agent/**

# OS
.DS_Store
Thumbs.db

# Private planning and positioning notes. They stay on disk for the author
# and are kept out of the public repository: they read as instructions for
# presenting the project, not as part of it.
llm-se-bench-upgrade-guide.txt
docs/describing-it.md
docs/positioning.md
