# llm-se-bench — environment template.
#
#   cp .env.example .env    and fill in the values you need.
#
# .env is git-ignored. This file must never carry a value: it documents
# names only. `python scripts/security_sweep.py` fails the build if a
# value appears here.

# ── Provider API keys ────────────────────────────────────────────────
# Only the providers you actually benchmark need a key. A missing key
# produces a clear error at client construction, not at call time.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Cost governance ──────────────────────────────────────────────────
# Hard ceiling, in EUR, for a single `llm-se-bench run` invocation and
# for the MCP `run_benchmark` tool. Empty means no ceiling, which is
# never what you want against a paid API.
LLM_SE_BENCH_BUDGET_EUR=

# USD per EUR, used to convert the ceiling above into the USD figures the
# provider price lists quote. Defaults to 1.08 when unset. Pin it for a
# published run so the reported euro cost is reproducible.
LLM_SE_BENCH_USD_PER_EUR=

# ── Storage ──────────────────────────────────────────────────────────
# SQLite file holding the response cache and per-call cost records.
# Defaults to ./llm_cache.db. This file contains full prompts and model
# outputs — it is git-ignored and must stay that way.
LLM_SE_BENCH_CACHE_PATH=
